# Copie ce fichier en ".env" puis remplis les valeurs.

# Port du site (les hébergeurs le fournissent souvent tout seuls)
PORT=3000

# Adresse publique du site, utile pour la connexion TikTok officielle
# PUBLIC_URL=https://star-discussion.mondomaine.fr

# E-mail du compte qui devient Fondateur (sinon : le premier compte créé)
ADMIN_EMAIL=

# ---- Envoi des codes par e-mail (SMTP) ----
# Exemple Gmail : active la validation en 2 étapes puis crée un
# "mot de passe d'application" sur https://myaccount.google.com/apppasswords
SMTP_HOST=
# Pour Gmail : SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ton.adresse@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM=Star Discussion <ton.adresse@gmail.com>
# Laisse SMTP_HOST vide pour le mode test : les codes s'affichent dans la console.

# ---- Connexion TikTok officielle (optionnel) ----
# Crée une app sur https://developers.tiktok.com (produit "Login Kit"),
# URL de redirection : <PUBLIC_URL>/api/tiktok/oauth/callback
# Sans ces clés, les membres lient leur TikTok avec un code dans leur bio.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Mets true si ton site est en https (cookies sécurisés)
COOKIE_SECURE=false

# ---- Accès admin sans compte ----
# Se connecter avec l'identifiant ADMIN_LOGIN (par défaut "admin") et ce mot de passe.
# Donne directement le rôle Fondateur. Laisse vide pour désactiver.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
ADMIN_NAME=Admin
